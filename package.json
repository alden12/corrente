{
  "name": "corrente",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:mobile": "MOBILE_HTTPS=1 vite --host --mode test",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:browser": "playwright install --with-deps chromium",
    "e2e:browser-deps": "playwright install-deps chromium",
    "mcp-server": "tsx server/index.ts",
    "check:server": "tsc -p tsconfig.server.json",
    "check:pwa": "tsx scripts/checkPwaOffline.ts",
    "engine:build": "node engine/compile.ts",
    "engine:check": "node engine/compile.ts --check",
    "engine:test": "node engine/compile.ts --test",
    "engine:costs": "MEASURE_COSTS=1 vitest run test/engineCosts.test.ts",
    "portraits": "tsx scripts/generatePortraits.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@fontsource-variable/google-sans-code": "^5.3.0",
    "@fontsource-variable/google-sans-flex": "^5.3.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.110.4",
    "@xyflow/react": "^12.11.2",
    "fflate": "^0.8.3",
    "idb": "^8.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}
