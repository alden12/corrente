    {
      "name": "loopgain",
      "kind": 8,
      "description": "The gain for a feedback loop: what a signal going round a loop of `period` samples is multiplied by each time round, so that it dies away by 60 dB in `time` seconds whatever the period. Keeps a plucked string's decay even from low notes to high ones. Both are controls, read every 32 samples, since they barely move within a note.",
      "inputs": [],
      "outputs": [
        {
          "name": "gain",
          "min": 0,
          "max": 1
        }
