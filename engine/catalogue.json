    {
      "name": "beatlfo",
      "kind": 2,
      "description": "A low-frequency oscillator locked to the beat: wire `beat` to host.beat and give `length` a cycle's length in beats (a synced input with as beats, or a number). Its phase is worked out from the beat alone, so it starts in the same place every time play starts and stays in step through tempo changes. Sine, triangle, saw and square outputs from -1 to 1, shaped like lfo's; `phase` shifts it (0.25 is a quarter cycle late).",
      "inputs": [
        {
          "name": "beat",
          "min": 0,
          "max": 100000,
          "unit": "beats"
        },
        {
          "name": "length",
          "min": 0.0625,
          "max": 64,
          "unit": "beats"
        }
      ],
      "outputs": [
        {
          "name": "sine",
          "min": -1,
          "max": 1
        },
        {
          "name": "triangle",
          "min": -1,
          "max": 1
        },
        {
          "name": "saw",
          "min": -1,
          "max": 1
        },
        {
          "name": "square",
          "min": -1,
          "max": 1
        }
      ],
      "controls": [
        {
          "name": "phase",
          "min": 0,
          "max": 1,
          "init": 0
        }
